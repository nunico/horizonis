{
	"name": "web-e2e",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/web-e2e",
	"targets": {
		"e2e": {
			"executor": "nx:run-commands",
			"options": {
				"command": "playwright test",
				"cwd": "apps/web-e2e"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "eslint .",
				"cwd": "apps/web-e2e"
			}
		}
	}
}
