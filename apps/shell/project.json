{
	"name": "horizonis-shell",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/shell/src",
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm exec -- tauri dev",
				"cwd": "apps/shell"
			}
		},
		"build": {
			"dependsOn": ["horizonis-client:build"],
			"executor": "nx:run-commands",
			"options": {
				"command": "npm exec -- tauri build",
				"cwd": "apps/shell"
			},
			"outputs": ["{projectRoot}/target/release/bundle"]
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "cargo clippy",
				"cwd": "apps/shell"
			}
		}
	}
}
