{
	"name": "e2e-tests",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/e2e-tests/test",
	"targets": {
		"e2e": {
			"executor": "nx:run-commands",
			"options": {
				"command": "wdio run wdio.conf.js",
				"cwd": "apps/e2e-tests"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "eslint .",
				"cwd": "apps/e2e-tests"
			}
		}
	}
}
