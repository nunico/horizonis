{
	"name": "horizonis-web",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/web/src",
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite dev",
				"cwd": "apps/web"
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite build",
				"cwd": "apps/web"
			},
			"outputs": ["{projectRoot}/build"]
		},
		"check": {
			"executor": "nx:run-commands",
			"options": {
				"command": "svelte-kit sync && svelte-check",
				"cwd": "apps/web"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "pnpm exec eslint . && pnpm exec prettier --check .",
				"cwd": "apps/web"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run",
				"cwd": "apps/web"
			}
		}
	}
}
