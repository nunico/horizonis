{
    "mcpServers": {
        "mise": {
            "command": "mise",
            "args": [
                "mcp"
            ],
            "env": {
                "MISE_EXPERIMENTAL": "1"
            }
        },
        "WebDriverIO": {
            "command": "node",
            "args": [
                "scripts/wdio-mcp-adapter.cjs"
            ]
        }
    }
}