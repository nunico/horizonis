{
	"mcpServers": {
		"mise": {
			"command": "node",
			"args": ["scripts/mise-mcp-adapter.cjs"]
		},
		"nx-mcp": {
			"command": ["pnpx", "nx", "mcp"]
		},
		"playwright": {
			"command": "pnpx",
			"args": ["@playwright/mcp@latest"]
		},
		"WebDriverIO": {
			"command": "node",
			"args": ["scripts/wdio-mcp-adapter.cjs"]
		}
	}
}
